# Copia este archivo a .env y ajusta los valores.
# docker-compose los lee automáticamente; también funcionan como
# variables de entorno al correr la app sin Docker.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=escuela_db
DB_USERNAME=escuela_user
DB_PASSWORD=escuela_pass
DB_ROOT_PASSWORD=root_pass

# JWT (el secreto debe tener al menos 32 caracteres)
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRATION=86400000

# Puerto de la API
SERVER_PORT=8080
